# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C, C++ and CMake: 4 spaces
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl,cmake}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

# JSON, YAML: 2 spaces
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown: 2 spaces; trailing whitespace is significant (line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Windows script files
[*.{bat,cmd,ps1}]
end_of_line = crlf
